# Relative cache and secrets paths are resolved from client/.
CACHE_FOLDER=cache
SECRETS_FOLDER=secrets

# All intervals are in seconds; DISPLAY_SECONDS must be a positive integer.
# IDLE_SECONDS, SYNC_INTERVAL, and NETWORK_TIMEOUT must be finite and >= 0.001.
DISPLAY_SECONDS=5
# Folder and month selections are independent; VIEW_MODE says which is active.
# Month buckets use UTC OSS modification dates and are stored newest first.
SELECTED_FOLDER=
SELECTED_MONTHS=
VIEW_MODE=folder
IDLE_SECONDS=0.5
SYNC_INTERVAL=30
# Cached images retain their aspect ratio and are never enlarged. Image quality
# applies to resized JPEG/WebP; resized PNG remains lossless. HEIC/HEIF uses
# its separate iPhone conversion quality.
CACHE_MAX_WIDTH=1600
CACHE_MAX_HEIGHT=900
OTHER_IMAGE_QUALITY=85
IPHONE_JPEG_QUALITY=75
# On a direct-DRM Linux console, inspect the connected display's advertised
# modes and prefer its largest progressive 30 Hz mode up to 1080p. If no such
# mode is advertised, MPV keeps its normal preferred-mode behavior.
HDMI_PREFERRED_HZ=30
HDMI_MAX_WIDTH=1920
HDMI_MAX_HEIGHT=1080
# Per-request HTTP timeout; cached playback continues if requests fail.
NETWORK_TIMEOUT=10
LOG_LEVEL=INFO

# Both devices are already on the same Wi-Fi. The detected browser URL is
# logged and shown on the slideshow; 0.0.0.0 is the server bind address.
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8000
# Seconds to show the URL at the top-left on slideshow startup; 0 disables it.
CONTROL_URL_DISPLAY_SECONDS=30

# Optional runtime-only helper. The minimal-OS launcher enables this explicitly;
# ordinary commands leave it disabled and nothing is enabled at boot.
WIFI_SETUP_ENABLED=false
WIFI_SOCKET=/run/digitalframe-network/control.sock

# Optional workaround from the Banana Pi display investigation. Device indices
# vary by machine; identify the connected display before enabling this setting.
# SDL_KMSDRM_DEVICE_INDEX=0

# Relative to SECRETS_FOLDER. Keep all OSS settings and credentials in this
# ignored file, not in this .env file.
OSS_CREDENTIALS_FILE=oss.env
