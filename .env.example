# Relative cache and secrets paths are resolved from client/.
CACHE_FOLDER=cache
SECRETS_FOLDER=secrets

# All intervals are in seconds.
DISPLAY_SECONDS=5
IDLE_SECONDS=0.5
SYNC_INTERVAL=1
LOG_LEVEL=INFO

# Optional workaround from the Banana Pi display investigation. Device indices
# vary by machine; identify the connected display before enabling this setting.
# SDL_KMSDRM_DEVICE_INDEX=0

GOOGLE_DRIVE_FOLDER_ID=1PCx8gffDxNx9AdDQjKPgpNyXBa74pxM1
# Filenames are relative to SECRETS_FOLDER; the token is created/refreshed there.
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_TOKEN_FILE=google_token.json
